    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capgo/capacitor-updater": "^8.54.2",
    "@ionic/vue": "^8.4.0",
    "@ionic/vue-router": "^8.4.0",
    "axios": "^1.7.9",
    "ionicons": "^7.4.0",
    "pinia": "^2.3.0",
    "swiper": "^11.2.10",
    "vue": "^3.5.13",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^4.5.0"
