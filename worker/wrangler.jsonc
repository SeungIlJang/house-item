{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-items-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // 서버 코드를 요청이 들어온 지점(한국 통신사는 흔히 미국)이 아니라 DB 가까이에서 돌린다.
  // 요청 하나가 DB 를 여러 번 조회하므로, 조회마다 바다를 건너는 왕복(약 0.14초씩)이 없어진다.
  "placement": { "mode": "smart" },
  "vars": {
    "APP_ENV": "production",
    // https://localhost = 안드로이드 앱 WebView, 나머지 = 웹 버전(home-items-app/wrangler.jsonc)
    "CORS_ORIGINS": "https://localhost,https://home-items.season-masil.workers.dev",
    "APP_REDIRECT_URI": "com.homeitems.app://auth",
    // 웹 소셜 로그인 복귀 허용 주소(쉼표 구분). 목록에 없는 주소로는 토큰을 보내지 않는다.
    "WEB_REDIRECT_URIS": "https://home-items.season-masil.workers.dev/auth/callback",
    "R2_PUBLIC_BASE_URL": "https://pub-fa27dec30c6241889d42241398b188fa.r2.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-items-db",
      "database_id": "844a0fa6-3cca-4156-b534-e7ac4c353a7f",
      "migrations_dir": "migrations"
    }
  ],
  // 사진에서 이름·유통기한 읽기(Workers AI). 무료 한도: 하루 10,000 뉴런.
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "home-items"
    }
  ]
}
