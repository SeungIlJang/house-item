# 로컬 개발용 Worker 비밀값 견본. `cp .dev.vars.example .dev.vars` 후 값을 채웁니다.
# .dev.vars 는 git 에 올리지 않습니다. 운영 값은 `npx wrangler secret put <이름>` 으로 넣습니다.

# 로그인 토큰 서명 키. 아무 긴 무작위 문자열.
JWT_SECRET_KEY=change-me-local-only

# 로컬 웹(vite)에서 호출할 수 있도록 허용할 출처
CORS_ORIGINS=http://localhost:5173,https://localhost

# 소셜 로그인 (로컬에서 로그인까지 시험할 때만 필요)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 선택: 회원 탈퇴 시 카카오 앱 연결 끊기
# KAKAO_ADMIN_KEY=
